# MediMind BTIS Development Environment
# Copy this file to .env and configure your settings

# ==================== Security ====================
# JWT secret key for authentication (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=medimind-dev-secret-key-change-me-in-production

# ==================== Database ====================
POSTGRES_USER=medimind
POSTGRES_PASSWORD=medimind_secure_password
POSTGRES_DB=medimind_db
DATABASE_URL=postgresql://medimind:medimind_secure_password@postgres:5432/medimind_db

# ==================== Redis ====================
REDIS_URL=redis://redis:6379/0

# ==================== LLM API Keys ====================
# OpenAI API Key (optional - for GPT-4 integration)
OPENAI_API_KEY=

# Anthropic API Key (optional - for Claude integration)
ANTHROPIC_API_KEY=

# ==================== Application Settings ====================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ==================== CORS Settings ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ==================== Model Settings ====================
MODEL_PATH=/app/models
USE_GPU=false

# ==================== Rate Limiting ====================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
